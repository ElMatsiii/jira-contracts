{
  "name": "jira-contracts",
  "version": "1.0.0",
  "description": "Shared Protobuf contracts, Kafka JSON schemas, and multi-language stubs for Jira AI",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist",
    "protos",
    "schemas",
    "gen"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./validator": {
      "types": "./dist/src/validator.d.ts",
      "default": "./dist/src/validator.js"
    },
    "./gen/ts": {
      "types": "./dist/gen/ts/index.d.ts",
      "default": "./dist/gen/ts/index.js"
    },
    "./dist/*": "./dist/*",
    "./schemas/*": "./schemas/*",
    "./protos/*": "./protos/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"const fs = require('fs'); fs.cpSync('schemas', 'dist/schemas', { recursive: true });\"",
    "build:all": "npm run generate:all && npm run build",
    "generate": "npm run generate:ts",
    "generate:all": "npm run generate:ts && npm run generate:go && npm run generate:csharp",
    "generate:ts": "node scripts/run-bash.js generate-ts.sh",
    "generate:go": "node scripts/run-bash.js generate-go.sh",
    "generate:csharp": "node scripts/run-bash.js generate-csharp.sh",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:consumer": "node scripts/verify-consumer.js",
    "test:e2e": "npm --prefix ../tests/e2e test",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "clean": "node -e \"const fs = require('fs'); ['dist', 'coverage'].forEach(d => fs.existsSync(d) && fs.rmSync(d, { recursive: true, force: true }));\""
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.3",
    "@grpc/grpc-js": "^1.12.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "ts-proto": "^2.18.3"
  },
  "devDependencies": {
    "@grpc/proto-loader": "^0.7.13",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.0",
    "jest": "^29.7.0",
    "protoc": "^34.2.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "jira",
    "contracts",
    "protobuf",
    "grpc",
    "kafka",
    "schemas",
    "typescript",
    "go",
    "csharp"
  ],
  "author": "Jira AI Platform Team",
  "license": "UNLICENSED"
}
